<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.avin.demo1fx.controller.SaveEmployer">
   <children>
      <Label fx:id="labe" layoutX="229.0" layoutY="52.0" prefHeight="30.0" prefWidth="141.0" text="Save Employer" textFill="#ef0a0a">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <TextField fx:id="txtId" layoutX="146.0" layoutY="123.0" prefHeight="25.0" prefWidth="307.0" promptText="Enter ID" />
      <TextField fx:id="txtName" layoutX="146.0" layoutY="167.0" prefHeight="25.0" prefWidth="307.0" promptText="Enter Name" />
      <TextField fx:id="txtAddress" layoutX="146.0" layoutY="214.0" prefHeight="25.0" prefWidth="307.0" promptText="Enter Address" />
      <TextField fx:id="txtPosition" layoutX="146.0" layoutY="262.0" prefHeight="25.0" prefWidth="307.0" promptText="Position" />
      <Button layoutX="40.0" layoutY="330.0" mnemonicParsing="false" onAction="#getAll" prefHeight="25.0" prefWidth="75.0" style="-fx-background-color: green;" text="Get All" textFill="#f6f3f3" />
      <Button layoutX="172.0" layoutY="330.0" mnemonicParsing="false" onAction="#update" prefHeight="25.0" prefWidth="75.0" style="-fx-background-color: #97a34d;" text="Update" textFill="#f8f8f7" />
      <Button layoutX="314.0" layoutY="330.0" mnemonicParsing="false" onAction="#delete" prefHeight="25.0" prefWidth="75.0" style="-fx-background-color: #000000;" text="Delete" textFill="#fbf7f7" />
      <Button layoutX="468.0" layoutY="330.0" mnemonicParsing="false" onAction="#save" prefHeight="25.0" prefWidth="75.0" style="-fx-background-color: #3538d4;" text="Save" textFill="#f5f5f6">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Button>
   </children>
</AnchorPane>
